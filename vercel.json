{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "shekhar-fawn.vercel.app"
        }
      ],
      "destination": "https://www.shekharkumar.com/:path*",
      "permanent": true
    },
    {
      "source": "/assets/Shekhar_Kumar_Resume.pdf",
      "destination": "/resume.pdf",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/opengraph-image",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/png"
        }
      ]
    },
    {
      "source": "/projects/:slug/opengraph-image",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/png"
        }
      ]
    }
  ]
}
